* text=auto

# Shell scripts and CI files must stay LF — they run on Linux (server + runner)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
/.deploy/rsync-exclude.txt text eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
